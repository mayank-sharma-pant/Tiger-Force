<dialog class="lightbox" id="lightbox" aria-label="Image viewer">
  <form method="dialog">
    <button class="lightbox-close" value="cancel" aria-label="Close">×</button>
  </form>
  <img id="lightbox-image" alt="" />
</dialog>

<script>
  function bindLightbox() {
    const dialog = document.querySelector<HTMLDialogElement>('#lightbox');
    const image = document.querySelector<HTMLImageElement>('#lightbox-image');
    if (!dialog || !image) return;
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    document.querySelectorAll<HTMLButtonElement>('[data-full]').forEach((node) => {
      if (node.dataset.bound) return;
      node.dataset.bound = 'true';
      node.addEventListener('click', () => {
        image.src = node.dataset.full || '';
        image.alt = node.dataset.alt || '';
        dialog.showModal();
      });
    });
  }

  document.addEventListener('astro:page-load', bindLightbox);
</script>
