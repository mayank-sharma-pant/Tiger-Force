<dialog id="lightbox">
  <form method="dialog">
    <button class="btn dialog-close" value="cancel">Close</button>
  </form>
  <img id="lightbox-image" alt="" />
</dialog>

<script>
  function bindLightbox() {
    const dialog = document.querySelector('#lightbox');
    const image = document.querySelector('#lightbox-image');
    if (!(dialog instanceof HTMLDialogElement) || !(image instanceof HTMLImageElement)) return;
    document.querySelectorAll('[data-full]').forEach((node) => {
      if (!(node instanceof HTMLButtonElement) || node.dataset.bound) return;
      node.dataset.bound = 'true';
      node.addEventListener('click', () => {
        const full = node.dataset.full;
        const alt = node.dataset.alt || '';
        if (!full) return;
        image.src = full;
        image.alt = alt;
        dialog.showModal();
      });
    });
  }
  bindLightbox();
  document.addEventListener('astro:page-load', bindLightbox);
</script>
