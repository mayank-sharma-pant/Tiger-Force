---
import { serviceLinks, site } from '../data/site';
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img src="/media/crest/group.png" alt="" width="48" height="40" loading="lazy" />
      <p>Security, housekeeping and manpower. DGR registered.</p>
    </div>
    <nav class="footer-links" aria-label="Footer">
      {serviceLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href="/clients">Clients</a>
      <a href="/contact">Contact</a>
    </nav>
    <p class="footer-contact">
      <a href={`tel:+91${site.phones[0]}`}>{site.phones[0]}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </div>
  <p class="footer-legal">© {new Date().getFullYear()} Tiger Force Group. {site.offices[0].line}</p>
</footer>
