---
import { aboutLinks, serviceLinks, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function current(href: string) {
  return path === href ? 'page' : undefined;
}

const aboutOpen = aboutLinks.some((link) => link.href === path);
const serviceOpen = serviceLinks.some((link) => link.href === path);
---

<header class="site-header">
  <a class="brand" href="/">
    <img src="/media/logo-wide.png" alt="" width="52" height="58" transition:name="crest" transition:persist />
    <span class="brand-name">Tiger Force <em>Group</em></span>
  </a>
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
    Menu
  </button>
  <nav id="site-nav" class="site-nav" aria-label="Primary">
    <a href="/" aria-current={current('/')}>Home</a>
    <details class="menu" open={aboutOpen || undefined}>
      <summary>About</summary>
      <div class="menu-panel">
        {aboutLinks.map((link) => (
          <a href={link.href} aria-current={current(link.href)}>{link.label}</a>
        ))}
      </div>
    </details>
    <details class="menu" open={serviceOpen || undefined}>
      <summary>Services</summary>
      <div class="menu-panel">
        {serviceLinks.map((link) => (
          <a href={link.href} aria-current={current(link.href)}>{link.label}</a>
        ))}
      </div>
    </details>
    <a href="/gallery" aria-current={current('/gallery')}>Gallery</a>
    <a href="/clients" aria-current={current('/clients')}>Clients</a>
    <a href="/documents" aria-current={current('/documents')}>Documents</a>
    <a href="/contact" aria-current={current('/contact')}>Contact</a>
  </nav>
  <a class="nav-phone" href={`tel:${site.phones[0]}`}>{site.phoneDisplay}</a>
</header>

<script>
  function bindNav() {
    const button = document.querySelector('.nav-toggle');
    const nav = document.querySelector('#site-nav');
    if (!(button instanceof HTMLButtonElement) || !(nav instanceof HTMLElement) || button.dataset.bound) return;
    button.dataset.bound = 'true';
    const close = () => {
      nav.classList.remove('is-open');
      button.setAttribute('aria-expanded', 'false');
      button.textContent = 'Menu';
    };
    button.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      button.setAttribute('aria-expanded', open ? 'true' : 'false');
      button.textContent = open ? 'Close' : 'Menu';
    });
    nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    document.addEventListener('astro:before-preparation', close);
  }
  bindNav();
  document.addEventListener('astro:page-load', bindNav);
</script>
