---
import Base from '../layouts/Base.astro';
import { sectors, site } from '../data/site';

const credentials = [
  { mark: 'DGR', text: 'Registered, Ministry of Defence' },
  { mark: 'PSARA', text: 'Licensed across multiple states' },
  { mark: 'ISO', text: '9001:2015 · 14001:2015 · SA 8000:2014' },
  { mark: 'CAPSI', text: 'Active member' },
  { mark: '20+ yrs', text: 'In security services' },
];

const panels = [
  { href: '/housekeeping', label: 'Housekeeping', note: 'Hotels, hospitals, offices', src: '/media/hero/housekeeping.jpg', alt: 'A Tiger Force housekeeper making up a hotel room.', position: '22% 22%' },
  { href: '/manpower', label: 'Manpower', note: 'Desks, hospitality, back office', src: '/media/hero/manpower.jpg', alt: 'An office executive in a business suit.', position: '50% 20%' },
  { href: '/security', label: 'Security', note: 'Gates, events, night posts', src: '/media/hero/security.jpg', alt: 'A Tiger Force guard in uniform on the radio.', position: '42% 28%' },
];

const wings = [
  {
    key: 'security',
    name: 'Security',
    href: '/security',
    crest: '/media/crest/security.png',
    photo: '/media/home/three.jpg',
    photoAlt: 'Three Tiger Force guards posted outside a building.',
    intro: 'Guards verified by the police before deployment and briefed before every shift. Headed by Col K. K. Nanda (Retd).',
    services: ['Uniformed guarding', 'Event and VIP security', 'Security audits and surveys', 'Investigations'],
  },
  {
    key: 'housekeeping',
    name: 'Housekeeping',
    href: '/housekeeping',
    crest: '/media/crest/housekeeping.png',
    photo: '/media/housekeeping-wide.jpg',
    photoAlt: 'A housekeeper preparing a hotel room.',
    intro: 'Mechanised cleaning, the right chemical for each surface, regular audits and a relationship manager for every site.',
    services: ['Offices and IT parks', 'Hospitals', 'Hotels', 'Factories and warehouses'],
  },
  {
    key: 'manpower',
    name: 'Manpower',
    href: '/manpower',
    crest: '/media/crest/manpower.png',
    photo: '/media/gallery/picture-20.jpg',
    photoAlt: 'Tiger Force staff at a reception desk.',
    intro: 'Front-office, hospitality and back-office staff, led by Mr Aditya Nanda, who specialises in the hospitality industry.',
    services: ['Reception desks', 'Data entry and office assistants', 'Food and beverage staff', 'Call centre and IT desks'],
  },
];

const posts = [
  { count: 894, name: 'Jamia Millia Islamia', role: 'General manpower', place: 'New Delhi' },
  { count: 112, name: 'Institute of Chartered Accountants of India', role: 'Security', place: 'Delhi and Noida' },
  { count: 98, name: 'Daikin Air-Conditioning India', role: 'Security', place: 'Neemrana, Rajasthan' },
  { count: 92, name: 'Fortis Escorts Heart Institute', role: 'Security and manpower', place: 'New Delhi' },
  { count: 65, name: 'Ministry of Defence, CWE', role: 'Tradesmen', place: 'New Delhi' },
  { count: 52, name: 'Army College of Medical Sciences', role: 'Security, housekeeping, horticulture', place: 'New Delhi' },
];

const supervision = [
  { value: 14, unit: 'Days', label: 'of training before a guard is deployed, including two days for your sector' },
  { value: 15, unit: 'Minutes', label: 'of briefing before every shift, and a debrief after it' },
  { value: 4, unit: 'Visits a week', label: 'by the area officer, signed in the muster book on site' },
  { value: 3, unit: 'Night checks a week', label: 'at varied hours, so every check is a surprise' },
];

const starPoints = [
  { title: 'Selection', text: 'Recruitment held to a high standard' },
  { title: 'Training', text: 'Quality training before anyone is posted' },
  { title: 'Manpower', text: 'Alert, efficient people on the post' },
  { title: 'Compliance', text: 'Statutory licences kept in order' },
  { title: 'Response', text: 'A fast answer, and value for money' },
];

const logos = Array.from({ length: 18 }, (_, index) => `/media/clients/client-${String(index + 1).padStart(2, '0')}.jpg`);

const gallery = [
  { src: '/media/gallery/picture-212.jpg', alt: 'Event security escorting guests at an exhibition.', label: 'Event security' },
  { src: '/media/gallery/picture-20.jpg', alt: 'Tiger Force staff at an event control desk.', label: 'Control desk' },
  { src: '/media/gallery/picture-12.jpg', alt: 'A firefighting drill during training.', label: 'Fire drill' },
  { src: '/media/gallery/picture-19.jpg', alt: 'Guards posted at an exhibition stand.', label: 'Exhibition duty' },
  { src: '/media/gallery/picture-1.jpg', alt: 'Tiger Force guards assembled for parade.', label: 'Morning parade' },
];
---

<Base
  title="Tiger Force Group"
  description="Tiger Force Group provides security, housekeeping and manpower services. Registered with DGR, Ministry of Defence. PSARA licensed and ISO certified. Led by Col K. K. Nanda (Retd)."
>
  <section class="hero" data-intro aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow" data-intro-fade>DGR registered · Ministry of Defence</p>
      <h1 id="hero-title">
        <span class="hero-line"><span>Guards,</span></span>
        <span class="hero-line"><span>housekeepers,</span></span>
        <span class="hero-line"><span>office staff.</span></span>
      </h1>
      <p class="hero-lede" data-intro-fade>
        For government offices, hospitals, universities, hotels and factories across Delhi NCR. Briefed before the
        shift. Checked on the post.
      </p>
      <div class="hero-actions" data-intro-fade>
        <a class="btn btn-yellow" href="/contact">Request a site survey</a>
        <a class="link-arrow" href={`tel:+91${site.phones[0]}`}>Call {site.phones[0]}</a>
      </div>
    </div>
    <div class="hero-panels">
      {panels.map((panel, index) => (
        <a class="hero-panel" href={panel.href}>
          <span class="hero-panel-media">
            <img
              src={panel.src}
              alt={panel.alt}
              style={`object-position:${panel.position}`}
              fetchpriority={index === 2 ? 'high' : undefined}
            />
          </span>
          <span class="hero-panel-copy">
            <span class="hero-panel-label">{panel.label}</span>
            <span class="hero-panel-note">{panel.note}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="creds" aria-label="Credentials">
    <ul>
      {credentials.map((item) => (
        <li><b>{item.mark}</b> {item.text}</li>
      ))}
    </ul>
  </section>

  <section class="wings is-steel" aria-labelledby="wings-title">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow" data-reveal>Three wings</p>
        <h2 id="wings-title" data-reveal>Security, housekeeping and manpower under one command</h2>
      </div>
      <div class="wing-grid">
        {wings.map((wing) => (
          <article class="wing" data-reveal>
            <figure class="wing-photo">
              <img src={wing.photo} alt={wing.photoAlt} loading="lazy" />
            </figure>
            <div class="wing-body">
              <img class="wing-crest" src={wing.crest} alt="" width="84" height="73" loading="lazy" />
              <h3>{wing.name}</h3>
              <p>{wing.intro}</p>
              <ul class="service-list">
                {wing.services.map((service) => <li>{service}</li>)}
              </ul>
              <a class="link-arrow" href={wing.href}>Explore {wing.name.toLowerCase()}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="posts" aria-labelledby="posts-title">
    <div class="wrap">
      <div class="posts-head">
        <div class="section-heading">
          <p class="eyebrow" data-reveal>On duty today</p>
          <h2 id="posts-title" data-reveal>Posts we hold right now</h2>
        </div>
        <p data-reveal>
          A partial list of current contracts, with the number of Tiger Force personnel deployed at each site.
        </p>
      </div>
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post" data-reveal>
            <span class="post-count">{post.count}<small>Deployed</small></span>
            <span class="post-name">{post.name}</span>
            <span class="post-role">{post.role}</span>
            <span class="post-place">{post.place}</span>
          </li>
        ))}
      </ul>
      <div class="posts-foot" data-reveal>
        <span>Performance certificates from clients are available on request.</span>
        <a class="link-arrow" href="/clients">See all clients</a>
      </div>
    </div>
  </section>

  <section class="standard is-dark" aria-labelledby="standard-title">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow" data-reveal>Supervision</p>
        <h2 id="standard-title" data-reveal>How every post is kept</h2>
        <p data-reveal>
          Every guard is vetted and verified by the police before deployment. After that, the same schedule runs at
          every site.
        </p>
      </div>
      <ul class="metrics">
        {supervision.map((item) => (
          <li data-reveal>
            <span class="metric-value">{item.value}</span>
            <span class="metric-unit">{item.unit}</span>
            <span class="metric-label">{item.label}</span>
          </li>
        ))}
      </ul>
      <div class="star">
        <div class="star-head">
          <h3 data-reveal>The Star: five points we are judged on</h3>
          <a class="link-arrow" href="/why-tiger-force" data-reveal>Why Tiger Force</a>
        </div>
        <ul class="star-points">
          {starPoints.map((point) => (
            <li data-reveal><b>{point.title}</b>{point.text}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="leader" aria-labelledby="leader-title">
    <div class="wrap leader-inner">
      <figure class="leader-photo" data-reveal>
        <img src="/media/team/kk-nanda.jpg" alt="Col K. K. Nanda (Retd)" width="348" height="371" loading="lazy" />
        <figcaption><strong>Col K. K. Nanda (Retd)</strong>Managing Director</figcaption>
      </figure>
      <div>
        <p class="eyebrow" data-reveal id="leader-title">From the Managing Director</p>
        <blockquote data-reveal>
          <p>
            We take pride in the welfare of our personnel and always pay them on time. Our security personnel are our
            strength.
          </p>
        </blockquote>
        <ul class="leader-facts">
          <li data-reveal><b>32 years</b> in the Indian Army</li>
          <li data-reveal><b>Instructor</b> at the National Defence Academy</li>
          <li data-reveal><b>Commanded</b> an infantry battalion</li>
          <li data-reveal><b>Organised</b> security for Mr Bill Gates</li>
        </ul>
        <div class="leader-links" data-reveal>
          <a class="btn btn-navy" href="/mds-profile">MD’s profile</a>
          <a class="link-arrow" href="/mds-message">Read the MD’s message</a>
        </div>
      </div>
    </div>
  </section>

  <section class="clients-band is-steel" aria-labelledby="clients-title">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow" data-reveal>Clients</p>
        <h2 id="clients-title" data-reveal>Trusted by government and industry</h2>
      </div>
      <ul class="sector-chips" data-reveal>
        {sectors.map((sector) => <li>{sector}</li>)}
      </ul>
      <div class="logo-grid" data-reveal>
        {logos.map((src) => (
          <div class="logo-cell"><img src={src} alt="" loading="lazy" /></div>
        ))}
      </div>
      <p class="center"><a class="link-arrow" href="/clients">See the full client list</a></p>
    </div>
  </section>

  <section class="gallery-band" aria-labelledby="gallery-title">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow" data-reveal>Gallery</p>
        <h2 id="gallery-title" data-reveal>On duty</h2>
      </div>
      <div class="mosaic">
        {gallery.map((shot) => (
          <a class="mosaic-item" href="/gallery" data-reveal="wipe">
            <img src={shot.src} alt={shot.alt} loading="lazy" />
            <span>{shot.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta" aria-labelledby="cta-title">
    <div class="cta-inner">
      <div>
        <h2 id="cta-title" data-reveal>Request a site survey</h2>
        <p data-reveal>
          We survey your premises and send a written report with our recommendations before anyone is deployed.
        </p>
      </div>
      <div class="cta-actions" data-reveal>
        <a class="btn btn-light" href="/contact">Send an enquiry</a>
        <a class="cta-phone" href={`tel:+91${site.phones[0]}`}>{site.phones[0]}</a>
      </div>
    </div>
  </section>
</Base>
