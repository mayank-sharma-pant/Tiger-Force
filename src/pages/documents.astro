---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import Lightbox from '../components/Lightbox.astro';

const docs = [
  { src: '/media/docs/document-1.jpg', alt: 'Tiger Force document 1.' },
  { src: '/media/docs/document-2.jpg', alt: 'Tiger Force document 2.' },
  { src: '/media/docs/document-3.jpg', alt: 'Tiger Force document 3.' },
];
---

<Base title="Documents" description="Registrations and documents published by Tiger Force Group.">
  <PageBanner title="Documents" lede="Registrations and certificates. Select a document to view it full size." current="Documents" />
  <div class="page-wide">
    <div class="doc-grid">
      {docs.map((doc, index) => (
        <button type="button" class="doc" data-full={doc.src} data-alt={doc.alt} data-reveal style={`--d:${index}`}>
          <img src={doc.src} alt={doc.alt} loading="lazy" />
          <span>View full size</span>
        </button>
      ))}
    </div>
  </div>
  <Lightbox />
</Base>
