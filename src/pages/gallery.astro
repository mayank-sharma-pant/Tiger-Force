---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import Lightbox from '../components/Lightbox.astro';

const shots = [
  { src: '/media/gallery/picture-1.jpg', alt: 'Tiger Force guards assembled for parade.', label: 'Morning parade' },
  { src: '/media/gallery/wa.jpg', alt: 'A briefing at a logistics yard.', label: 'Warehouse briefing' },
  { src: '/media/gallery/picture-12.jpg', alt: 'A firefighting drill during training.', label: 'Fire drill' },
  { src: '/media/gallery/picture-19.jpg', alt: 'Guards posted at an exhibition stand.', label: 'Exhibition duty' },
  { src: '/media/gallery/picture-212.jpg', alt: 'Event security escorting guests.', label: 'Event security' },
  { src: '/media/gallery/picture-20.jpg', alt: 'Tiger Force staff at a reception desk.', label: 'Control desk' },
  { src: '/media/hero.jpg', alt: 'Tiger Force guards in uniform.', label: 'Uniformed guards' },
  { src: '/media/housekeeping-2.jpg', alt: 'A housekeeper preparing a hotel room.', label: 'Hotel housekeeping' },
];
---

<Base title="Gallery" description="Photographs of Tiger Force Group teams on duty.">
  <PageBanner title="Gallery" lede="Tiger Force teams on duty: training, events, warehouses and front desks." current="Gallery" />
  <div class="page-wide">
    <div class="photo-grid">
      {shots.map((shot, index) => (
        <button type="button" class="photo" data-full={shot.src} data-alt={shot.alt} data-reveal="wipe" style={`--d:${index % 3}`}>
          <img src={shot.src} alt={shot.alt} loading="lazy" />
          <span>{shot.label}</span>
        </button>
      ))}
    </div>
  </div>
  <Lightbox />
</Base>
