---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="Contact" description="Write to Tiger Force Group, or call the Delhi and Gurgaon offices.">
  <header class="page-hero">
    <p class="kicker">Contact</p>
    <h1>Write to the desk.</h1>
    <p class="lede">The form opens an email to {site.email}. Both offices and all three numbers stay on this page.</p>
  </header>
  <div class="sheet-wrap">
    <div class="contact-layout">
      <form class="sheet" id="enquiry" novalidate>
        <div class="field">
          <label for="name"><span>Name</span></label>
          <input id="name" name="name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="phone"><span>Phone</span></label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" required />
        </div>
        <div class="field">
          <label for="email"><span>Email, if you want a reply there</span></label>
          <input id="email" name="email" type="email" autocomplete="email" />
        </div>
        <div class="field">
          <label for="message"><span>Message</span></label>
          <textarea id="message" name="message" required></textarea>
        </div>
        <p class="form-error" id="form-error" role="alert"></p>
        <button class="btn" type="submit">Open email</button>
        <p class="form-status" id="form-status" hidden>
          Your email app should open with this message addressed to {site.email}. If it does not, copy that address and send it yourself.
        </p>
      </form>
      <div>
        {site.offices.map((office) => (
          <article class="office-card">
            <h2>{office.label}</h2>
            <p>{office.line}</p>
          </article>
        ))}
        <article class="office-card">
          <h2>Lines</h2>
          {site.phones.map((phone) => (
            <p><a href={`tel:+91${phone.replace(/^0/, '')}`}>{phone}</a></p>
          ))}
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
          <p><a href={`mailto:${site.emailAlt}`}>{site.emailAlt}</a></p>
          <p>{site.websites.join(' · ')}</p>
        </article>
      </div>
    </div>
  </div>
</Base>

<script>
  import { site } from '../data/site';

  function bindForm() {
    const form = document.querySelector('#enquiry');
    if (!(form instanceof HTMLFormElement) || form.dataset.bound) return;
    form.dataset.bound = 'true';
    const error = document.querySelector('#form-error');
    const status = document.querySelector('#form-status');
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!(error instanceof HTMLElement) || !(status instanceof HTMLElement)) return;
      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const phone = String(data.get('phone') || '').trim();
      const email = String(data.get('email') || '').trim();
      const message = String(data.get('message') || '').trim();
      const digits = phone.replace(/\D/g, '');
      if (!name || digits.length < 8 || !message) {
        error.textContent = 'Add your name, a phone number, and the message.';
        status.hidden = true;
        return;
      }
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        error.textContent = 'That email address is not usable. Correct it, or leave the field empty.';
        status.hidden = true;
        return;
      }
      error.textContent = '';
      const body = [`Name: ${name}`, `Phone: ${phone}`, email ? `Email: ${email}` : '', '', message]
        .filter((line) => line !== '')
        .join('\n');
      const href = `mailto:${site.email}?subject=${encodeURIComponent(`Enquiry from ${name}`)}&body=${encodeURIComponent(body)}`;
      window.location.href = href;
      status.hidden = false;
    });
  }

  bindForm();
  document.addEventListener('astro:page-load', bindForm);
</script>
