---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import { site } from '../data/site';
---

<Base title="Contact" description="Contact Tiger Force Group in New Delhi and Gurgaon by phone, email or enquiry form.">
  <PageBanner
    title="Contact us"
    lede="Tell us about your site. We will call you back, survey the premises and send our recommendations."
    current="Contact"
  />
  <div class="page-wide contact-grid">
    <form class="enquiry" id="enquiry" novalidate data-reveal>
      <h2>Send an enquiry</h2>
      <div class="field-row">
        <label class="field">
          <span>Name</span>
          <input name="name" autocomplete="name" required />
        </label>
        <label class="field">
          <span>Phone</span>
          <input name="phone" type="tel" autocomplete="tel" required />
        </label>
      </div>
      <label class="field">
        <span>Email (optional)</span>
        <input name="email" type="email" autocomplete="email" />
      </label>
      <fieldset class="field">
        <legend>Service</legend>
        <div class="choice-row">
          <label><input type="radio" name="service" value="Security" checked /> Security</label>
          <label><input type="radio" name="service" value="Housekeeping" /> Housekeeping</label>
          <label><input type="radio" name="service" value="Manpower" /> Manpower</label>
        </div>
      </fieldset>
      <label class="field">
        <span>Message</span>
        <textarea name="message" rows="5" required placeholder="Site location, type of premises and how many people you need."></textarea>
      </label>
      <p class="form-error" role="alert" data-error></p>
      <button class="btn btn-yellow" type="submit">Send enquiry</button>
      <p class="form-note" data-status hidden>
        Your email app should now open with this enquiry addressed to {site.email}. If it does not, email us
        directly or call {site.phones[0]}.
      </p>
    </form>

    <div class="contact-info" data-reveal style="--d:1">
      <div class="info-block">
        <h2>Call</h2>
        {site.phones.map((phone) => (
          <a class="info-big" href={`tel:+91${phone.replace(/^0/, '')}`}>{phone}</a>
        ))}
      </div>
      <div class="info-block">
        <h2>Email</h2>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={`mailto:${site.emailAlt}`}>{site.emailAlt}</a>
      </div>
      {site.offices.map((office) => (
        <div class="info-block">
          <h2>{office.label}</h2>
          <p>{office.line}</p>
        </div>
      ))}
    </div>
  </div>
</Base>

<script>
  import { site } from '../data/site';

  function bindForm() {
    const form = document.querySelector<HTMLFormElement>('#enquiry');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = 'true';
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const phone = String(data.get('phone') || '').trim();
      const email = String(data.get('email') || '').trim();
      const service = String(data.get('service') || '');
      const message = String(data.get('message') || '').trim();

      if (!name || phone.replace(/\D/g, '').length < 8 || !message) {
        error.textContent = 'Enter your name, a phone number with at least 8 digits, and a message.';
        status.hidden = true;
        return;
      }
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        error.textContent = 'Check the email address, or leave it empty.';
        status.hidden = true;
        return;
      }

      error.textContent = '';
      const lines = [`Name: ${name}`, `Phone: ${phone}`];
      if (email) lines.push(`Email: ${email}`);
      lines.push(`Service: ${service}`, '', message);
      const body = lines.join('\n');
      window.location.href = `mailto:${site.email}?subject=${encodeURIComponent(`${service} enquiry from ${name}`)}&body=${encodeURIComponent(body)}`;
      status.hidden = false;
    });
  }

  document.addEventListener('astro:page-load', bindForm);
</script>
