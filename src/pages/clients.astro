---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import { clientsNamed, sectors } from '../data/site';

const logos = Array.from({ length: 39 }, (_, index) => `/media/clients/client-${String(index + 1).padStart(2, '0')}.jpg`);
const run = logos.slice(0, 18);
---

<Base
  title="Clients"
  description="Organisations served by Tiger Force Group across government, healthcare, hospitality, retail and industry."
>
  <PageBanner
    title="Our clients"
    lede="Government organisations, universities, hospitals, hotels, manufacturers and logistics companies."
    current="Clients"
  />
  <div class="page-wide clients-page">
    <p class="clients-count">{logos.length} organisations</p>
    <div class="logo-run" aria-hidden="true">
      <div class="logo-run-track">
        {[...run, ...run].map((src) => <img src={src} alt="" />)}
      </div>
    </div>
    <ul class="sector-chips is-left">
      {sectors.map((sector) => <li>{sector}</li>)}
    </ul>
    <div class="logo-grid">
      {logos.map((src, index) => (
        <div class="logo-cell" style={`--d:${index % 6}`}>
          <img src={src} alt={`Client logo ${index + 1}`} loading="lazy" />
        </div>
      ))}
    </div>
    <h2 class="page-subhead" data-reveal>Organisations we have served</h2>
    <ul class="name-columns">
      {clientsNamed.map((name) => <li data-reveal>{name}</li>)}
    </ul>
  </div>
</Base>
